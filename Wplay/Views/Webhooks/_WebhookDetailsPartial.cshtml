@model Wplay.Models.WebhookRequest

<article class="rounded-2xl border border-border bg-surface p-5 shadow-sm sm:p-7">
    <div class="flex flex-col justify-between gap-3 border-b border-border pb-4 sm:flex-row sm:items-start">
        <div class="min-w-0">
            <span class="mr-2 inline-flex rounded-md bg-primary-hover px-2 py-1 text-xs font-bold text-white">@Model.Method</span>
            <span class="break-all text-sm font-semibold text-foreground">@Model.Url</span>
        </div>
        <button type="button" class="shrink-0 rounded-lg border border-danger-tint bg-danger-tint px-3 py-2 text-sm font-semibold text-danger transition hover:bg-danger hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-danger"
                hx-delete="/webhooks/@Model.Id"
                hx-target="#details-pane"
                hx-swap="innerHTML">
            Delete Log
        </button>
    </div>

    <dl class="mt-5 grid gap-3 sm:grid-cols-3">
        <div class="rounded-lg bg-surface-2 p-3">
            <dt class="text-xs font-medium text-text-secondary">Status Code</dt>
            <dd class="mt-1 font-semibold text-foreground">@Model.ResponseCode</dd>
        </div>
        <div class="rounded-lg bg-surface-2 p-3">
            <dt class="text-xs font-medium text-text-secondary">Client IP</dt>
            <dd class="mt-1 font-semibold text-foreground">@(Model.IpAddress ?? "N/A")</dd>
        </div>
        <div class="rounded-lg bg-surface-2 p-3">
            <dt class="text-xs font-medium text-text-secondary">Received At</dt>
            <dd class="mt-1 font-semibold text-foreground">@Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm:ss")</dd>
        </div>
    </dl>

    <div data-tabs class="mt-6">
        <div role="tablist" aria-label="Request data" class="flex gap-1 overflow-x-auto border-b border-border">
            <button type="button" id="body-tab" role="tab" aria-selected="true" aria-controls="body-panel" tabindex="0"
                    data-tab-target="body-panel"
                    class="shrink-0 border-b-2 border-transparent px-3 py-2.5 text-sm font-semibold text-text-secondary hover:text-foreground aria-selected:border-primary aria-selected:text-primary-strong focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-primary">
                Body
            </button>
            <button type="button" id="headers-tab" role="tab" aria-selected="false" aria-controls="headers-panel" tabindex="-1"
                    data-tab-target="headers-panel"
                    class="shrink-0 border-b-2 border-transparent px-3 py-2.5 text-sm font-semibold text-text-secondary hover:text-foreground aria-selected:border-primary aria-selected:text-primary-strong focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-primary">
                Headers
            </button>
            <button type="button" id="query-tab" role="tab" aria-selected="false" aria-controls="query-panel" tabindex="-1"
                    data-tab-target="query-panel"
                    class="shrink-0 border-b-2 border-transparent px-3 py-2.5 text-sm font-semibold text-text-secondary hover:text-foreground aria-selected:border-primary aria-selected:text-primary-strong focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-primary">
                Query Parameters
            </button>
        </div>

        <div id="body-panel" role="tabpanel" aria-labelledby="body-tab" tabindex="0" class="mt-4 focus-visible:outline-2 focus-visible:outline-primary">
            @if (string.IsNullOrWhiteSpace(Model.Body))
            {
                <p class="text-sm text-text-muted">No request body provided.</p>
            }
            else
            {
                <pre class="max-h-[32rem] overflow-auto rounded-xl bg-fog-950 p-4 text-sm leading-6 text-fog-100"><code>@Model.Body</code></pre>
            }
        </div>

        <div id="headers-panel" role="tabpanel" aria-labelledby="headers-tab" tabindex="0" hidden class="mt-4 focus-visible:outline-2 focus-visible:outline-primary">
            <pre class="max-h-[32rem] overflow-auto rounded-xl bg-fog-950 p-4 text-sm leading-6 text-fog-100"><code>@(Model.HeadersNode?.ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true }) ?? "{}")</code></pre>
        </div>

        <div id="query-panel" role="tabpanel" aria-labelledby="query-tab" tabindex="0" hidden class="mt-4 focus-visible:outline-2 focus-visible:outline-primary">
            <pre class="max-h-[32rem] overflow-auto rounded-xl bg-fog-950 p-4 text-sm leading-6 text-fog-100"><code>@(Model.QueryParametersNode?.ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true }) ?? "{}")</code></pre>
        </div>
    </div>
</article>
