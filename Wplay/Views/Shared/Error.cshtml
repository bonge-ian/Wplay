@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-danger-tint bg-surface p-6 sm:p-8">
        <p class="text-sm font-semibold text-danger">Something went wrong</p>
        <h1 class="mt-2 text-2xl font-bold tracking-tight text-foreground">An error occurred while processing your request.</h1>

        @if (Model.ShowRequestId)
        {
            <p class="mt-5 text-sm text-text-secondary">
                <strong class="font-semibold text-foreground">Request ID:</strong>
                <code class="ml-1 rounded bg-surface-2 px-2 py-1 font-mono">@Model.RequestId</code>
            </p>
        }

        <div class="mt-8 border-t border-border pt-5">
            <h2 class="font-semibold text-foreground">Development Mode</h2>
            <p class="mt-2 text-sm leading-6 text-text-secondary">
                Swapping to <strong class="font-semibold text-foreground">Development</strong> environment will display more detailed information about the error that occurred.
            </p>
            <p class="mt-3 text-sm leading-6 text-text-secondary">
                <strong class="font-semibold text-foreground">The Development environment shouldn't be enabled for deployed applications.</strong>
                It can result in displaying sensitive information from exceptions to end users. For local debugging, enable the
                <strong class="font-semibold text-foreground">ASPNETCORE_ENVIRONMENT</strong> environment variable by setting it to
                <strong class="font-semibold text-foreground">Development</strong> and restarting the app.
            </p>
        </div>
    </div>
</section>
