<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Wplay</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/uikit/css/uikit.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Wplay.styles.css" asp-append-version="true" />
</head>
<body>
    @Html.AntiForgeryToken()
    <header>
        <div class="uk-box-shadow-small uk-background-default uk-margin-bottom">
            <div class="uk-container">
                <nav class="uk-navbar-container uk-navbar-transparent" uk-navbar>
                    <div class="uk-navbar-left">
                        <a class="uk-navbar-item uk-logo" asp-area="" asp-controller="Home" asp-action="Index">Wplay</a>
                        <ul class="uk-navbar-nav uk-visible@s">
                            <li>
                                <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li>
                                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                        </ul>
                    </div>

                    <!-- Mobile Toggle -->
                    <div class="uk-navbar-right uk-hidden@s">
                        <a class="uk-navbar-toggle" uk-navbar-toggle-icon uk-toggle="target: #mobile-nav"></a>
                    </div>
                </nav>
            </div>
        </div>

        <!-- Mobile Navigation Drawer -->
        <div id="mobile-nav" uk-offcanvas="overlay: true">
            <div class="uk-offcanvas-bar">
                <button class="uk-offcanvas-close" type="button" uk-close></button>
                <ul class="uk-nav uk-nav-default uk-margin-top">
                    <li class="uk-nav-header">Wplay</li>
                    <li>
                        <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li>
                        <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <div class="uk-container uk-margin-medium-bottom">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="uk-section uk-section-xsmall uk-section-muted uk-margin-large-top">
        <div class="uk-container uk-text-center uk-text-meta">
            &copy; 2026 - Wplay - <a class="uk-link-muted" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/htmx/htmx.min.js"></script>
    <script src="~/lib/uikit/js/uikit.min.js"></script>
    <script src="~/lib/uikit/js/uikit-icons.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
            document.addEventListener("DOMContentLoaded", function() {
                document.body.addEventListener('htmx:configRequest', (event) => {
                    const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (tokenElement) {
                        event.detail.headers['RequestVerificationToken'] = tokenElement.value;
                    }
                });
            });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
