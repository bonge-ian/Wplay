@{
    ViewData["Title"] = "Real-time Webhook & Email Inspector";

    var curlCommand = """
    curl -X POST https://wplay.dev/hp/{your-bucket-uuid} \
      -H "Content-Type: application/json" \
      -d '{"event": "payment.succeeded", "amount": 2900}'
    """;
}

<!-- Hero Section -->
<div class="uk-section uk-section-medium uk-text-center uk-background-slate-900 uk-position-relative">
    <div class="uk-container uk-container-small">
        <span class="uk-label uk-background-teal-100 uk-color-teal-800 uk-text-bold uk-margin-small-bottom">
            Developer Sandbox
        </span>

        <h1 class="uk-heading-medium uk-text-bold uk-margin-small-top uk-color-white">
            Inspect, Mock & Test <br class="uk-visible@s" />
            <span class="uk-color-teal-400">Webhooks & Inbound Emails</span>
        </h1>

        <p class="uk-text-lead uk-color-slate-300 uk-margin-medium-bottom">
            Capture raw HTTP payloads, inspect headers in real time, and simulate network fault lotteries with zero friction.
        </p>

        <!-- Hero Actions -->
        <div class="uk-flex uk-flex-center uk-flex-middle uk-grid-small" uk-grid>
            <div>
                <form asp-controller="Endpoint" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="uk-button uk-button-large uk-background-teal-600 uk-color-white uk-border-transparent uk-border-rounded uk-text-bold">
                        <span uk-icon="icon: plus-circle" class="uk-margin-small-right"></span> Create Bucket Now
                    </button>
                </form>
            </div>
            <div>
                <a href="#demo" class="uk-button uk-button-large uk-background-slate-800 uk-color-slate-200 uk-border-slate-700 uk-border-rounded" uk-scroll>
                    View Interactive Demo
                </a>
            </div>
        </div>
        <p class="uk-text-meta uk-color-slate-400 uk-margin-small-top">Instant ephemeral buckets &bull; Zero sign-up needed</p>
    </div>
</div>

<!-- Demo & Overrides Section -->
<div class="uk-section uk-section-small uk-margin-medium-top" id="demo">
    <div class="uk-container">
        <div class="uk-card uk-card-body uk-background-white uk-border-slate-200 uk-border-rounded uk-box-shadow-small">
            <div class="uk-grid-divider uk-child-width-1-2@m" uk-grid>
                <!-- cURL Trigger -->
                <div>
                    <h4 class="uk-card-title uk-text-bold uk-margin-small-bottom uk-color-slate-900">
                        <span uk-icon="icon: code" class="uk-margin-small-right uk-color-teal-600"></span>
                        Send Test Webhook
                    </h4>
                    <p class="uk-text-meta uk-margin-remove-top uk-color-slate-500">Trigger payloads via cURL or any backend integration:</p>

                    <div class="uk-margin-top">
                        <pre class="uk-background-slate-950 uk-border-slate-800 uk-border-rounded uk-padding-small"><code>@curlCommand</code></pre>
                    </div>
                </div>

                <!-- Modifiers -->
                <div>
                    <h4 class="uk-card-title uk-text-bold uk-margin-small-bottom uk-color-slate-900">
                        <span uk-icon="icon: settings" class="uk-margin-small-right uk-color-amber-500"></span>
                        Dynamic URL Overrides
                    </h4>
                    <p class="uk-text-meta uk-margin-remove-top uk-color-slate-500">Control execution behavior directly via route modifiers:</p>

                    <ul class="uk-list uk-list-striped uk-text-small uk-margin-top">
                        <li class="uk-flex uk-flex-between uk-flex-middle">
                            <code class="uk-color-rose-600">/force-500</code>
                            <span class="uk-color-slate-600">Forces a 500 Internal Error</span>
                        </li>
                        <li class="uk-flex uk-flex-between uk-flex-middle">
                            <code class="uk-color-amber-600">/404</code>
                            <span class="uk-color-slate-600">Returns 404 Not Found</span>
                        </li>
                        <li class="uk-flex uk-flex-between uk-flex-middle">
                            <code class="uk-color-teal-600">?lottery=30</code>
                            <span class="uk-color-slate-600">30% chance of random failure</span>
                        </li>
                        <li class="uk-flex uk-flex-between uk-flex-middle">
                            <code class="uk-color-sky-600">?delay=2000</code>
                            <span class="uk-color-slate-600">Injects 2000ms latency</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Features Grid -->
<div class="uk-section uk-section-small">
    <div class="uk-container">
        <div class="uk-text-center uk-margin-medium-bottom">
            <h2 class="uk-text-bold uk-color-slate-900">Everything Needed for Inspection</h2>
            <p class="uk-color-slate-500">Designed with a high-throughput C# engine, HTMX real-time feeds, and zero framework bloat.</p>
        </div>

        <div class="uk-grid-match uk-child-width-1-3@m uk-child-width-1-2@s" uk-grid>
            <div>
                <div class="uk-card uk-card-body uk-background-white uk-border-slate-200 uk-border-rounded">
                    <div class="uk-color-teal-600 uk-margin-small-bottom" uk-icon="icon: bolt; ratio: 1.4"></div>
                    <h3 class="uk-card-title uk-margin-small-top uk-text-bold uk-color-slate-900">Real-time Stream</h3>
                    <p class="uk-color-slate-500 uk-text-small">
                        Watch webhooks arrive live using HTMX partial updates without refreshing your browser.
                    </p>
                </div>
            </div>

            <div>
                <div class="uk-card uk-card-body uk-background-white uk-border-slate-200 uk-border-rounded">
                    <div class="uk-color-amber-500 uk-margin-small-bottom" uk-icon="icon: warning; ratio: 1.4"></div>
                    <h3 class="uk-card-title uk-margin-small-top uk-text-bold uk-color-slate-900">Failure Lotteries</h3>
                    <p class="uk-color-slate-500 uk-text-small">
                        Stress-test your system's HTTP retry logic with query-based random failure chances.
                    </p>
                </div>
            </div>

            <div>
                <div class="uk-card uk-card-body uk-background-white uk-border-slate-200 uk-border-rounded">
                    <div class="uk-color-emerald-600 uk-margin-small-bottom" uk-icon="icon: mail; ratio: 1.4"></div>
                    <h3 class="uk-card-title uk-margin-small-top uk-text-bold uk-color-slate-900">Inbound Emails</h3>
                    <p class="uk-color-slate-500 uk-text-small">
                        Send emails to <code>{uuid}@@inbound.wplay.dev</code> and inspect HTML, text, and raw headers.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
