@{
    ViewData["Title"] = "Real-time Webhook & Email Inspector";

    var curlCommand = """
    curl -X POST https://wplay.dev/hp/{your-bucket-uuid} \
      -H "Content-Type: application/json" \
      -d '{"event": "payment.succeeded", "amount": 2900}'
    """;
}

<section class="bg-fog-950 px-4 py-20 text-center text-fog-100 sm:px-6 sm:py-28">
    <div class="mx-auto max-w-4xl">
        <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
            Inspect, Mock &amp; Test
            <span class="mt-2 block text-cerulean-400">Webhooks &amp; Inbound Emails</span>
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-fog-300 sm:text-xl">
            Capture raw HTTP payloads, inspect headers in real time, and simulate network fault lotteries with zero friction.
        </p>
        <span class="mt-5 inline-flex rounded-full border border-fog-700 bg-fog-900 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-fog-300">
            Developer Sandbox
        </span>

        <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
            <form asp-controller="Endpoints" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-lg bg-primary-hover px-6 py-3 font-semibold text-white transition hover:bg-primary-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cerulean-300 sm:w-auto">
                    <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 5v14M5 12h14" />
                    </svg>
                    Create Bucket Now
                </button>
            </form>
            <a href="#demo" class="inline-flex min-h-12 items-center justify-center rounded-lg border border-fog-700 bg-fog-900 px-6 py-3 font-semibold text-fog-100 transition hover:border-fog-500 hover:bg-fog-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cerulean-300">
                View Interactive Demo
            </a>
        </div>
        <p class="mt-4 text-sm text-fog-400">Instant ephemeral buckets &bull; Zero sign-up needed</p>
    </div>
</section>

<section id="demo" class="scroll-mt-8 px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-7xl rounded-2xl border border-border bg-surface p-6 shadow-sm sm:p-8 lg:p-10">
        <div class="grid gap-10 md:grid-cols-2 md:gap-12">
            <div>
                <h2 class="flex items-center gap-3 text-xl font-bold text-foreground">
                    <svg aria-hidden="true" class="size-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="m8 8-4 4 4 4m8-8 4 4-4 4m-3-11-2 14" />
                    </svg>
                    Send Test Webhook
                </h2>
                <p class="mt-2 text-sm text-text-secondary">Trigger payloads via cURL or any backend integration:</p>
                <pre class="mt-5 overflow-x-auto rounded-xl bg-fog-950 p-4 text-sm leading-6 text-fog-100"><code>@curlCommand</code></pre>
            </div>

            <div>
                <h2 class="flex items-center gap-3 text-xl font-bold text-foreground">
                    <svg aria-hidden="true" class="size-5 text-warning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 8v4m0 4h.01M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3l-7.5-13a2 2 0 0 0-3.4-.1Z" />
                    </svg>
                    Dynamic URL Overrides
                </h2>
                <p class="mt-2 text-sm text-text-secondary">Control execution behavior directly via route modifiers:</p>
                <ul class="mt-5 divide-y divide-border text-sm">
                    <li class="flex items-center justify-between gap-4 py-3">
                        <code class="font-medium text-danger">/force-500</code>
                        <span class="text-right text-text-secondary">Forces a 500 Internal Error</span>
                    </li>
                    <li class="flex items-center justify-between gap-4 py-3">
                        <code class="font-medium text-ochre-700">/404</code>
                        <span class="text-right text-text-secondary">Returns 404 Not Found</span>
                    </li>
                    <li class="flex items-center justify-between gap-4 py-3">
                        <code class="font-medium text-primary-strong">?lottery=30</code>
                        <span class="text-right text-text-secondary">30% chance of random failure</span>
                    </li>
                    <li class="flex items-center justify-between gap-4 py-3">
                        <code class="font-medium text-cerulean-800">?delay=2000</code>
                        <span class="text-right text-text-secondary">Injects 2000ms latency</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="px-4 pb-16 pt-4 sm:px-6 sm:pb-20">
    <div class="mx-auto max-w-7xl">
        <div class="mb-8 max-w-2xl">
            <h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">Everything Needed for Inspection</h2>
            <p class="mt-3 text-text-secondary">Designed with a high-throughput C# engine, HTMX real-time feeds, and zero framework bloat.</p>
        </div>

        <div class="grid divide-y divide-border border-y border-border sm:grid-cols-3 sm:divide-x sm:divide-y-0">
            <article class="py-6 sm:px-6 sm:first:pl-0">
                <svg aria-hidden="true" class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M13.2 2 4.8 13h6.1L10.8 22l8.4-11h-6.1L13.2 2Z" />
                </svg>
                <h3 class="mt-4 font-semibold text-foreground">Real-time Stream</h3>
                <p class="mt-2 text-sm leading-6 text-text-secondary">
                    Watch webhooks arrive live using HTMX partial updates without refreshing your browser.
                </p>
            </article>

            <article class="py-6 sm:px-6">
                <svg aria-hidden="true" class="size-6 text-warning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 8v4m0 4h.01M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3l-7.5-13a2 2 0 0 0-3.4-.1Z" />
                </svg>
                <h3 class="mt-4 font-semibold text-foreground">Failure Lotteries</h3>
                <p class="mt-2 text-sm leading-6 text-text-secondary">
                    Stress-test your system's HTTP retry logic with query-based random failure chances.
                </p>
            </article>

            <article class="py-6 sm:px-6 sm:last:pr-0">
                <svg aria-hidden="true" class="size-6 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                </svg>
                <h3 class="mt-4 font-semibold text-foreground">Inbound Emails</h3>
                <p class="mt-2 text-sm leading-6 text-text-secondary">
                    Send emails to <code class="font-mono text-sm">{uuid}@@inbound.wplay.dev</code> and inspect HTML, text, and raw headers.
                </p>
            </article>
        </div>
    </div>
</section>
