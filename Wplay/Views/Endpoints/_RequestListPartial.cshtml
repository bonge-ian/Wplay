@model IEnumerable<Wplay.Models.WebhookRequest>

@if (!Model.Any())
{
    <div class="flex min-h-56 flex-col items-center justify-center rounded-2xl border border-dashed border-border-strong bg-surface px-6 py-10 text-center">
        <svg aria-hidden="true" class="mb-4 size-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M20 11a8 8 0 0 0-14.9-4M4 4v4h4m-4 5a8 8 0 0 0 14.9 4M20 20v-4h-4" />
        </svg>
        <h3 class="font-semibold text-foreground">Waiting for Requests</h3>
        <p class="mt-2 max-w-xs text-sm leading-6 text-text-secondary">
            Send a web request to your bucket URL to see it stream live here.
        </p>
    </div>
}
else
{
    <div class="flex flex-col gap-2">
        @foreach (var request in Model)
        {
            var badgeColor = request.Method.ToUpper() switch
            {
                "POST" => "bg-primary-hover text-white",
                "GET" => "bg-sky-700 text-white",
                "PUT" => "bg-ochre-100 text-ochre-900",
                "DELETE" => "bg-danger text-white",
                _ => "bg-fog-700 text-white"
            };

            var statusColor = request.ResponseCode >= 200 && request.ResponseCode < 300
                ? "text-moss-700"
                : "text-danger";

            <button type="button"
               class="w-full rounded-xl border border-border bg-surface p-4 text-left transition hover:border-primary/50 hover:bg-surface-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
               hx-get="/webhooks/@request.Id"
               hx-target="#details-pane"
               hx-swap="innerHTML">
                <div class="flex items-center justify-between gap-3">
                    <div class="flex min-w-0 items-center gap-3">
                        <span class="shrink-0 rounded-md px-2 py-1 text-xs font-bold @badgeColor">@request.Method</span>
                        <span class="truncate text-sm font-semibold text-foreground">@request.IpAddress</span>
                    </div>
                    <span class="shrink-0 text-sm font-bold @statusColor">@request.ResponseCode</span>
                </div>
                <div class="mt-3 flex items-center justify-between gap-3 text-xs text-text-muted">
                    <span class="max-w-[16rem] truncate font-mono">@request.Url</span>
                    <time class="shrink-0" datetime="@request.CreatedAt?.ToString("O")">@request.CreatedAt?.ToString("HH:mm:ss")</time>
                </div>
            </button>
        }
    </div>
}